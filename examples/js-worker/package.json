{
  "name": "js-worker-example",
  "version": "0.0.0",
  "private": true,
  "description": "Example Cloudflare Worker using @openfeature/flagd-ofrep-cf-worker",
  "main": "src/index.ts",
  "scripts": {
    "predev": "npm run build --workspace=@openfeature/flagd-ofrep-cf-worker",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "presmoke": "npm run build --workspace=@openfeature/flagd-ofrep-cf-worker",
    "smoke": "wrangler deploy --dry-run",
    "pretest": "npm run build --workspace=@openfeature/flagd-ofrep-cf-worker",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openfeature/flagd-ofrep-cf-worker": "*",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.114.0"
  }
}
