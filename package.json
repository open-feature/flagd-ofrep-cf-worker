{
  "name": "flagd-ofrep-cf-worker",
  "version": "0.0.0",
  "private": true,
  "description": "flagd OFREP Cloudflare Worker - JS implementation for in-process flag evaluation",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:worker": "npm run test --workspace=js-worker-example",
    "test:smoke:worker": "npm run smoke --workspace=js-worker-example",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "dev": "npm run dev --workspace=examples/js-worker",
    "deploy": "npm run deploy --workspace=examples/js-worker",
    "prepare": "husky || true"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "keywords": [
    "openfeature",
    "flagd",
    "ofrep",
    "cloudflare",
    "workers",
    "feature-flags"
  ],
  "author": "OpenFeature",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-feature/flagd-ofrep-cf-worker.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openfeature/ofrep-core": "2.3.0",
    "@openfeature/ofrep-provider": "0.2.5",
    "@openfeature/server-sdk": "1.23.0",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.8",
    "shx": "0.4.0",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.56.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.29.0",
      "sharp": "0.35.4"
    },
    "esbuild": "^0.28.1"
  }
}
